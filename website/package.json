{
  "name": "open-bed-climate-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"test/*.test.ts\"",
    "budget": "node scripts/budget.mjs",
    "links": "linkinator dist --recurse --skip \"^https?://(?!localhost|127\\.0\\.0\\.1)\"",
    "data": "cd ../software/opod && uv run python -m opod.site_data",
    "guard": "node scripts/guard.mjs",
    "verify": "npm run check && npm test && npm run build && npm run budget && npm run guard && npm run links"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.3.5",
    "smol-toml": "1.9.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "linkinator": "8.1.0"
  }
}
