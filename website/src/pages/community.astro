---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { DISCUSSIONS_URL, REPO_URL } from "../site.ts";
const people = await getCollection("contributors");
---
<Base title="Community" description="Where to ask, show your build and follow updates. Every kind of contribution counts.">
  <section class="container page-head">
    <p class="eyebrow">Community</p>
    <h1 class="h-lg">Every kind of contribution counts.</h1>
    <p class="lead muted">Build reports, parts research, safety reviews, docs and translations are credited the same way as code, using the all-contributors convention.</p>
  </section>
  <div class="container comm">
    <div class="grid grid--3">
      <a class="card" href={DISCUSSIONS_URL}><h2 class="h-sm">Discussions</h2><p class="small muted">Questions, "show your build", ideas and parts hunting. Public, searchable, same login as the code.</p></a>
      <a class="card" href={`${REPO_URL}/issues`}><h2 class="h-sm">Issues</h2><p class="small muted">For actionable things: build reports, part substitutions and safety concerns, each with a template.</p></a>
      <a class="card" href="/rss.xml"><h2 class="h-sm">Build log (RSS)</h2><p class="small muted">One update per milestone, not per calendar. No e-mail list yet, and no tracking.</p></a>
    </div>
    <section aria-labelledby="people">
      <h2 id="people" class="h-md">Contributors</h2>
      {people.length === 0
        ? <p class="muted">The repository is not public yet, so this list is empty. Contributors will appear here from <code>.all-contributorsrc</code>, with avatars downloaded at build time and served from this site.</p>
        : <ul class="people">{people.map((p) => <li><span class="mono">{p.data.name}</span> <span class="small muted">{p.data.contributions.join(", ")}</span></li>)}</ul>}
    </section>
  </div>
</Base>
<style>
  .page-head { padding-block: var(--s-2xl) var(--s-xl); display: grid; gap: var(--s-md); }
  .page-head .lead { max-width: 72ch; }
  .comm { display: grid; gap: var(--s-2xl); padding-bottom: var(--s-2xl); }
  .comm section { display: grid; gap: var(--s-md); }
  a.card h2 { color: var(--ink); }
  .people { list-style: none; padding: 0; display: grid; gap: 8px; }
</style>
