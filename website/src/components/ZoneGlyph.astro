---
interface Props { zones: 1 | 2; size?: number }
const { zones, size = 44 } = Astro.props;
---
<svg class="zone-glyph" width={size} height={size} viewBox="0 0 44 44" aria-hidden="true" focusable="false">
  <rect x="5" y="3" width="34" height="38" rx="4" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.6"></rect>
  {zones === 2 ? (
    <>
      <rect class="zg-cold" x="9" y="13" width="12" height="24" rx="2"></rect>
      <rect class="zg-warm" x="23" y="13" width="12" height="24" rx="2"></rect>
      <rect x="9" y="6" width="12" height="5" rx="2" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.6"></rect>
      <rect x="23" y="6" width="12" height="5" rx="2" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.6"></rect>
    </>
  ) : (
    <>
      <rect class="zg-cold" x="9" y="13" width="26" height="24" rx="2"></rect>
      <rect x="15" y="6" width="14" height="5" rx="2" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.6"></rect>
    </>
  )}
</svg>
<style>
  .zone-glyph { color: var(--ink-muted); flex: none; }
  .zg-cold { fill: var(--temp-20); opacity: 0.85; }
  .zg-warm { fill: var(--temp-36); opacity: 0.85; }
</style>
