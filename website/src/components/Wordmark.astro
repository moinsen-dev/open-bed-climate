---
import { SITE_NAME } from "../site.ts";
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<span class="wordmark">
  <svg width={size} height={size} viewBox="0 0 28 28" aria-hidden="true" focusable="false">
    <rect x="1.5" y="3.5" width="25" height="21" rx="4" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.55"></rect>
    <rect class="wm-cold" x="5" y="7" width="8" height="14" rx="2"></rect>
    <rect class="wm-warm" x="15" y="7" width="8" height="14" rx="2"></rect>
  </svg>
  <span class="wordmark__text">{SITE_NAME}</span>
</span>
<style>
  .wordmark { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); }
  .wordmark__text { font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; letter-spacing: -0.015em; white-space: nowrap; }
  .wm-cold { fill: var(--temp-20); }
  .wm-warm { fill: var(--temp-36); }
</style>
