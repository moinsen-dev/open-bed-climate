---
import Wordmark from "./Wordmark.astro";
import { FOOTER_NAV, REPO_URL, CONTACT_EMAIL, LICENSES, SITE_NAME, IMPRESSUM_URL, PRIVACY_URL } from "../site.ts";
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Wordmark />
        <p class="small muted">Open hardware ({LICENSES.hardware}), open software and docs ({LICENSES.software}). Site content {LICENSES.siteContent}.</p>
        <p class="small">
          <a href={REPO_URL}>Repository</a> ·
          Contact: <a class="mono" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> ·
          <a href="/rss.xml">RSS</a>
        </p>
      </div>
      {FOOTER_NAV.map((col) => (
        <nav aria-label={col.title}>
          <p class="eyebrow">{col.title}</p>
          <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="site-footer__legal small">
      <p><strong>{SITE_NAME} is an experimental DIY project.</strong> Nothing here is certified, sold or supported as a product. Not a medical device. Build and use at your own risk.</p>
      <p>Not affiliated with or endorsed by any bed-cooling manufacturer. All product names belong to their owners.</p>
      <p>No cookies, no analytics, no third-party requests. <a href="/privacy/">Privacy on this site</a> · <a href={PRIVACY_URL}>Privacy policy</a> · <a href={IMPRESSUM_URL}>Impressum</a></p>
    </div>
  </div>
</footer>
<style>
  .site-footer { background: var(--surface); border-top: 1px solid var(--hairline); padding-block: var(--s-2xl) var(--s-xl); margin-top: var(--s-2xl); }
  .site-footer__top { display: grid; gap: var(--s-xl) var(--s-lg); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .site-footer__brand { grid-column: 1 / -1; display: grid; gap: var(--s-sm); max-width: 44ch; align-content: start; }
  .site-footer ul { list-style: none; padding: 0; margin-top: var(--s-sm); display: grid; gap: 4px; }
  .site-footer nav a { color: var(--ink); text-decoration: none; font-size: 0.9375rem; display: inline-flex; min-height: 32px; align-items: center; }
  .site-footer nav a:hover { color: var(--link); text-decoration: underline; }
  .site-footer__legal { margin-top: var(--s-2xl); padding-top: var(--s-lg); border-top: 1px solid var(--hairline); color: var(--ink-muted); display: grid; gap: 6px; }
  .site-footer__legal strong { color: var(--ink); font-weight: 600; }
  @media (min-width: 900px) {
    .site-footer__top { grid-template-columns: 1.6fr repeat(4, minmax(0, 1fr)); }
    .site-footer__brand { grid-column: auto; }
  }
</style>
